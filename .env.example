# Required for Google OAuth sign-in and sheet write operations.
VITE_GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com

# Required for unauthenticated reads of a publicly shared sheet.
VITE_GOOGLE_API_KEY=your-google-api-key

# Optional. Vite asset base path. Default is "/".
# For GitHub project Pages locally preview: VITE_BASE=/REPO_NAME/
# CI sets this automatically from the repository name.
# VITE_BASE=/
